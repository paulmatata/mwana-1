APP_NAME=Mwana
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mwana
DB_USERNAME=root
DB_PASSWORD=

# Only needed against a managed DB that requires SSL (e.g. Aiven). Locally, leave
# both blank. In production, set DB_SSL_CA_CONTENT in your host's environment
# variables (not here) - see DEPLOY.md. DB_SSL_CA below is set automatically by
# docker/entrypoint.sh at container startup, not something you set by hand.
DB_SSL_CA=
DB_SSL_VERIFY=true

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mwana.app"
MAIL_FROM_NAME="${APP_NAME}"
